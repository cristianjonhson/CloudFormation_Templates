# =============================================================
# .gitignore — AWS CloudFormation Project
# =============================================================

# -------------------------------------
# macOS
# -------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# -------------------------------------
# IDEs y editores
# -------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -------------------------------------
# AWS CLI & credenciales
# Nunca versionar credenciales o configs
# con datos sensibles de la cuenta AWS
# -------------------------------------
.aws/
aws-exports.js
*.pem
*.key

# -------------------------------------
# AWS SAM (Serverless Application Model)
# -------------------------------------
.aws-sam/
samconfig.toml

# -------------------------------------
# CloudFormation — artefactos generados
# Plantillas empaquetadas por "sam package"
# o "aws cloudformation package"
# -------------------------------------
*.packaged.yaml
*.packaged.json
packaged-template.yaml
packaged-template.json

# -------------------------------------
# cfn-lint (linter de CloudFormation)
# -------------------------------------
.cfnlintrc
cfn-lint-output.json

# -------------------------------------
# Taskcat (herramienta de testing de CF)
# -------------------------------------
.taskcat_outputs/
.taskcat.yml

# -------------------------------------
# Variables de entorno y secretos
# -------------------------------------
.env
.env.*
*.env
secrets.yaml
secrets.json

# -------------------------------------
# Logs y temporales
# -------------------------------------
*.log
tmp/
temp/
